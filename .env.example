# --- AI (required): get a free key at https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=your-key-here
# Pick a free Flash / Flash-Lite model shown in AI Studio (names change over time)
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Optional: backups, tried in this order when the main model is rate limited or down
# Other models on the same key (each model has its own limits), comma separated:
GEMINI_FALLBACK_MODELS=
# Keys from OTHER Google projects (keys in the SAME project share one quota), comma separated:
GEMINI_EXTRA_KEYS=
# Any OpenAI-compatible service, e.g. Groq (https://api.groq.com/openai/v1) or OpenRouter (https://openrouter.ai/api/v1):
FALLBACK_API_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# --- Optional
# How many AI requests run at once (lower it if you hit rate limits)
AI_CONCURRENCY=2
# Windows only, if Tesseract is not on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# Where the app listens. Keep 127.0.0.1: there is no login, so only your own computer should reach it.
HOST=127.0.0.1
PORT=5000
